# Database Configuration (PostgreSQL / Prisma Postgres)
DATABASE_URL="postgres://..."

# NEAR Protocol Configuration
NEXT_PUBLIC_NEAR_NETWORK="testnet"
NEXT_PUBLIC_NEAR_RPC_URL="https://rpc.testnet.near.org"
NEXT_PUBLIC_NEAR_EXPLORER_URL="https://testnet.nearblocks.io"
NEXT_PUBLIC_NEAR_WALLET_URL="https://testnet.mynearwallet.com"

# NEAR.AI Cloud API (https://cloud.near.ai / https://docs.near.ai/)
NEARAI_API_KEY=""
NEARAI_BASE_URL="https://api.near.ai/v1"
NEARAI_MODEL="nearai/llama-3.1-70b-instruct"

# AI Fallback Service (DeepSeek API)
DEEPSEEK_API_KEY=""
DEEPSEEK_API_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# SputnikDAO & Trezu Governance
NEXT_PUBLIC_SPUTNIK_DAO_CONTRACT="paysure-council.sputnik-dao.testnet"

# App Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NestJS backend proxy
# Leave empty to keep using the legacy Next.js route handlers.
# Set to the backend URL to route /api/* through NestJS.
BACKEND_URL="http://localhost:4000"
